ажениях с помощью нейросетей</p>\n        </div>\n        \n        <div className=\"feature-card\">\n          <h3>Цензурирование</h3>\n          <p>Размытие и скрытие обнаруженных областей для защиты приватности</p>\n        </div>\n        \n        <div className=\"feature-card\">\n          <h3>Безопасное хранение</h3>\n          <p>Ваши файлы безопасно хранятся в изолированных контейнерах</p>\n        </div>\n      </div>\n\n      <div className=\"action-section\">\n        {user ? (\n          // Если пользователь авторизован\n          <div className=\"user-actions\">\n            <h2>Добро пожаловать, {user.username}! </h2>\n            <p>Вы можете начать работу с редактором изображений</p>\n            <Link to=\"/redaction\" className=\"action-button primary\">\n              Перейти в редактор\n            </Link>\n          </div>\n        ) : (\n          // Если пользователь не авторизован\n          <div className=\"guest-actions\">\n            <h2>Начните работу с системой</h2>\n            <p>Зарегистрируйтесь или войдите в систему для доступа к функциям</p>\n            <div className=\"action-buttons\">\n              <Link to=\"/register\" className=\"action-button primary\">\n                Зарегистрироваться\n              </Link>\n              <Link to=\"/login\" className=\"action-button secondary\">\n                Войти в систему\n              </Link>\n            </div>\n          </div>\n        )}\n      </div>\n\n      <div className=\"info-section\">\n        <h3>Как это работает?</h3>\n        <div className=\"steps\">\n          <div className=\"step\">\n            <span className=\"step-number\">1</span>\n            <p>Загрузите изображение</p>\n          </div>\n          <div className=\"step\">\n            <span className=\"step-number\">2</span>\n            <p>Система автоматически обнаружит лица</p>\n          </div>\n          <div className=\"step\">\n            <span className=\"step-number\">3</span>\n            <p>Примените цензурирование к нужным областям</p>\n          </div>\n          <div className=\"step\">\n            <span className=\"step-number\">4</span>\n            <p>Скачайте обработанное изображение</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Home;"],"mappings":"AAAA;AACA,MAAO,CAAAA,KAAK,KAAM,OAAO,CACzB,OAASC,IAAI,KAAQ,kBAAkB,CACvC,OAASC,OAAO,KAAQ,yBAAyB,CACjD,MAAO,YAAY,CAAE;AAAA,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAErB,KAAM,CAAAC,IAAc,CAAGA,CAAA,GAAM,CAC3B,KAAM,CAAEC,IAAK,CAAC,CAAGN,OAAO,CAAC,CAAC,CAE1B,mBACEI,KAAA,QAAKG,SAAS,CAAC,gBAAgB,CAAAC,QAAA,eAC7BJ,KAAA,QAAKG,SAAS,CAAC,cAAc,CAAAC,QAAA,eAC3BN,IAAA,OAAAM,QAAA,CAAI,oMAAkC,CAAI,CAAC,cAC3CN,IAAA,MAAAM,QAAA,CAAG,8TAA6D,CAAG,CAAC,EACjE,CAAC,cAENJ,KAAA,QAAKG,SAAS,CAAC,kBAAkB,CAAAC,QAAA,eAC/BJ,KAAA,QAAKG,SAAS,CAAC,cAAc,CAAAC,QAAA,eAC3BN,IAAA,OAAAM,QAAA,CAAI,uFAAe,CAAI,CAAC,cACxBN,IAAA,MAAAM,QAAA,CAAG,iXAAmE,CAAG,CAAC,EACvE,CAAC,cAENJ,KAAA,QAAKG,SAAS,CAAC,cAAc,CAAAC,QAAA,eAC3BN,IAAA,OAAAM,QAAA,CAAI,sFAAc,CAAI,CAAC,cACvBN,IAAA,MAAAM,QAAA,CAAG,yVAA+D,CAAG,CAAC,EACnE,CAAC,cAENJ,KAAA,QAAKG,SAAS,CAAC,cAAc,CAAAC,QAAA,eAC3BN,IAAA,OAAAM,QAAA,CAAI,+GAAmB,CAAI,CAAC,cAC5BN,IAAA,MAAAM,QAAA,CAAG,0TAAyD,CAAG,CAAC,EAC7D,CAAC,EACH,CAAC,cAENN,IAAA,QAAKK,SAAS,CAAC,gBAAgB,CAAAC,QAAA,CAC5BF,IAAI,cACH;AACAF,KAAA,QAAKG,SAAS,CAAC,cAAc,CAAAC,QAAA,eAC3BJ,KAAA,OAAAI,QAAA,EAAI,+FAAkB,CAACF,IAAI,CAACG,QAAQ,CAAC,IAAE,EAAI,CAAC,cAC5CP,IAAA,MAAAM,QAAA,CAAG,oQAAgD,CAAG,CAAC,cACvDN,IAAA,CAACH,IAAI,EAACW,EAAE,CAAC,YAAY,CAACH,SAAS,CAAC,uBAAuB,CAAAC,QAAA,CAAC,oGAExD,CAAM,CAAC,EACJ,CAAC,cAEN;AACAJ,KAAA,QAAKG,SAAS,CAAC,eAAe,CAAAC,QAAA,eAC5BN,IAAA,OAAAM,QAAA,CAAI,yIAAyB,CAAI,CAAC,cAClCN,IAAA,MAAAM,QAAA,CAAG,8UAA8D,CAAG,CAAC,cACrEJ,KAAA,QAAKG,SAAS,CAAC,gBAAgB,CAAAC,QAAA,eAC7BN,IAAA,CAACH,IAAI,EAACW,EAAE,CAAC,WAAW,CAACH,SAAS,CAAC,uBAAuB,CAAAC,QAAA,CAAC,8GAEvD,CAAM,CAAC,cACPN,IAAA,CAACH,IAAI,EAACW,EAAE,CAAC,QAAQ,CAACH,SAAS,CAAC,yBAAyB,CAAAC,QAAA,CAAC,kFAEtD,CAAM,CAAC,EACJ,CAAC,EACH,CACN,CACE