{
  "name": "image-redaction-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "cross-env": "^7.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.22.0",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "2.1.4"
  },
  "scripts": {
    "dev": "cross-env DANGEROUSLY_DISABLE_HOST_CHECK=true WDS_SOCKET_HOST=localhost WDS_SOCKET_PORT=3000 react-scripts start",
    "start": "cross-env DANGEROUSLY_DISABLE_HOST_CHECK=true WDS_SOCKET_HOST=localhost WDS_SOCKET_PORT=3000 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --verbose",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false --verbose",
    "test:coverage": "cross-env CI=true react-scripts test --watchAll=false --coverage --verbose",
    "test:e2e": "playwright test --reporter=list",
    "eject": "react-scripts eject"
  },
  "proxy": "http://127.0.0.1:8001",
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@testing-library/user-event": "^14.5.2"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 9,
        "functions": 10,
        "lines": 10,
        "statements": 10
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/index.tsx",
      "!src/react-app-env.d.ts",
      "!src/**/__tests__/**"
    ]
  }
}
